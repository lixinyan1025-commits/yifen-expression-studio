# Only the local Node server reads these. Never use VITE_ for a secret.
PORT=4317
# Optional read-only link to the Obsidian wisdom directory; no browser-supplied paths.
OBSIDIAN_WISDOM_PATH=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
TOPIC_MODEL=gpt-4o-mini
# Must accept Chat Completions input_audio (wav) and return text.
AUDIO_MODEL=gpt-audio
# Must accept verbose_json and timestamp_granularities[]=segment.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
